#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "linsmod"
            VALUE "FileDescription", "aidbg - AI-friendly GDB-style Windows command-line debugger"
            VALUE "FileVersion", "@PROJECT_VERSION@@AIDBG_GIT_SUFFIX@ (commit @AIDBG_GIT_HASH@)"
            VALUE "InternalName", "aidbg"
            VALUE "LegalCopyright", "Copyright (c) linsmod. Licensed under LGPL-3.0."
            VALUE "OriginalFilename", "aidbg.exe"
            VALUE "ProductName", "aidbg"
            VALUE "ProductVersion", "@PROJECT_VERSION@@AIDBG_GIT_SUFFIX@ (commit @AIDBG_GIT_HASH@)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
